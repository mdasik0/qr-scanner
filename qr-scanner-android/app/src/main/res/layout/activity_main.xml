<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#081C15">

    <!-- Scan: camera + result table -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/scanLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/scanCard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/scanCard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#121F1A"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.46"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/scanModeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#95D5B2"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/status_ready"
                android:textColor="#D8F3DC"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/resultTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#4ADE80"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <HorizontalScrollView
                android:id="@+id/tableScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:visibility="gone">

                <ScrollView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fillViewport="true">

                    <TableLayout
                        android:id="@+id/resultTable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:stretchColumns="*" />
                </ScrollView>
            </HorizontalScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scanAgainButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/scan_again"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/changeModeButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/change_mode"
                android:textColor="#95D5B2" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Mode pick -->
    <ScrollView
        android:id="@+id/modeLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@string/app_name"
                android:src="@drawable/app_logo" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/app_version_label"
                android:textColor="#4ADE80"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/mode_title"
                android:textColor="#D8F3DC"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/connectedUrlText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#95D5B2"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scannerModeButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:text="@string/mode_scanner" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/mode_scanner_hint"
                android:textColor="#95D5B2"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/seeDataModeButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:text="@string/mode_see_data" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/mode_see_data_hint"
                android:textColor="#95D5B2"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/changeUrlButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/change_url"
                android:textColor="#95D5B2" />
        </LinearLayout>
    </ScrollView>

    <!-- API URL setup -->
    <ScrollView
        android:id="@+id/setupLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@string/app_name"
                android:src="@drawable/app_logo" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/app_version_label"
                android:textColor="#4ADE80"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/setup_title"
                android:textColor="#D8F3DC"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/setup_hint"
                android:textColor="#95D5B2"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/setup_url_label"
                android:textColor="#D8F3DC"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/setupUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#1B4332"
                android:hint="@string/setup_url_hint"
                android:inputType="textUri"
                android:padding="14dp"
                android:textColor="#D8F3DC"
                android:textColorHint="#6B9080"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/setup_user_label"
                android:textColor="#D8F3DC"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/setupUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#1B4332"
                android:hint="@string/setup_user_hint"
                android:inputType="textEmailAddress"
                android:padding="14dp"
                android:textColor="#D8F3DC"
                android:textColorHint="#6B9080"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/setup_password_label"
                android:textColor="#D8F3DC"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/setupPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#1B4332"
                android:hint="@string/setup_password_hint"
                android:inputType="textPassword"
                android:padding="14dp"
                android:textColor="#D8F3DC"
                android:textColorHint="#6B9080"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/continueButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="@string/setup_continue" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
